    {
      "id": "vla_world_models",
      "name": "VLA世界模型",
      "aliases": ["视觉-语言-动作世界模型", "VLA-World"],
      "category": "academic",
      "first_appeared": "2026-04-13",
      "latest_version": "v1",
      "latest_update": "2026-04-13",
      "priority": "high",
      "description": "VLA-World结合预测想象和反思推理的视觉-语言-动作世界模型，提高自动驾驶预见性",
      "history": [
        {
          "date": "2026-04-13",
          "version": "v1",
          "description": "提出VLA-World，一个简单而有效的VLA世界模型，它将预测想象与反思推理相结合，以提高驾驶预见性。VLA-World首先使用动作导出的可行轨迹来指导下一帧图像的生成，捕捉描述周围环境如何演变的丰富空间和时间线索。然后，模型对这个自生成的未来想象帧进行推理，以细化预测的轨迹，实现更高的性能和更好的可解释性。",
          "key_points": [
            "结合预测想象与反思推理的VLA世界模型",
            "使用动作导出的可行轨迹指导下一帧图像生成",
            "对自生成的未来想象帧进行推理以细化轨迹",
            "提高驾驶预见性和可解释性"
          ],
          "sources": [
            "https://arxiv.org/abs/2604.09059"
          ]
        }
      ]
    }
  ]
