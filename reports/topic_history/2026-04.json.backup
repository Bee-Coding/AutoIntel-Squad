    {
      "id": "commonsense_world_trajectory_planning",
      "name": "常识世界轨迹规划",
      "aliases": ["C-TRAIL框架", "LLM常识推理轨迹规划", "信任机制轨迹规划"],
      "category": "academic",
      "description": "C-TRAIL框架基于常识世界耦合LLM常识推理与信任机制指导轨迹规划，实现安全关键的自动驾驶决策",
      "first_appeared": "2026-04-01",
      "latest_version": "v1.0",
      "latest_update": "2026-04-01",
      "priority": "high",
      "history": [
        {
          "date": "2026-04-01",
          "version": "v1.0",
          "description": "提出C-TRAIL框架，基于常识世界耦合LLM常识推理与信任机制指导轨迹规划，通过闭环Recall-Plan-Update循环实现安全关键的自动驾驶决策。在Highway-env仿真和real-world levelXData数据集上实验显示优于SOTA基线，平均减少ADE 40.2%、FDE 51.7%，提高SR 16.9个百分点。",
          "key_points": [
            "基于常识世界的轨迹规划框架",
            "耦合LLM常识推理与双信任机制",
            "通过闭环Recall-Plan-Update循环实现安全决策",
            "实验显示显著性能提升"
          ],
          "sources": [
            "https://arxiv.org/abs/2603.29908v1"
          ]
        }
      ]
    },
